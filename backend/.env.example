# Backend environment variables only.
# For local development, copy this file to backend/.env.
# For deployment, add these variables to the backend hosting provider only.
# Never expose this file or its secrets as VITE_* frontend variables.

# Backend server
# Preferred port. If occupied, the backend automatically tries the next port.
PORT=3000
# Set this to the deployed frontend origin in production (without a trailing slash).
# Example: https://your-portfolio.example.com
CORS_ORIGIN=http://localhost:5174

# Admin authentication
ADMIN_PASSWORD=change-this-password
ADMIN_PIN=123456

# Portfolio storage
PORTFOLIO_DATA_PATH=./backend/src/seeds/portfolioData.json
# Kept only for serving legacy /uploads URLs. New uploads go to Cloudinary.
UPLOAD_DIR=./backend/uploads

# Cloudinary (required for Admin image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio-v2

# Local MySQL development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=porto_rlsmp_v2
DB_CONNECTION_LIMIT=10

# Clever Cloud injects these automatically when a MySQL add-on is linked.
# You do not need to copy the MYSQL_ADDON_* values to the frontend.
# MYSQL_ADDON_HOST=
# MYSQL_ADDON_PORT=
# MYSQL_ADDON_USER=
# MYSQL_ADDON_PASSWORD=
# MYSQL_ADDON_DB=

# PDF generator (optional)
PORTFOLIO_PDF_URL=http://localhost:5174/portfolio-pdf
PORTFOLIO_PDF_OUTPUT=output/pdf/rizky-lanang-portfolio.pdf
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
