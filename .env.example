# Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# Profile, social media, resume, project, and contact links are stored in MySQL.

# Frontend API
# Leave VITE_PORTFOLIO_API_URL empty for same-origin API, or set a separate backend URL.
VITE_ADMIN_AUTH_MODE=server
VITE_PORTFOLIO_API_URL=
VITE_PORT=5174

# Backend runtime
PORT=3000
CORS_ORIGIN=http://localhost:5174
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PIN=replace-with-a-6-digit-pin

# Cloudinary (server only; never expose these as VITE_* variables)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio-v2

# Local MySQL. On Clever Cloud, linked MYSQL_ADDON_* variables are read automatically.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=porto_rlsmp_v2
DB_CONNECTION_LIMIT=10
