# Frontend environment variables only.
# For local development, copy this file to .env.local in the project root.
# For deployment, add these variables to the frontend hosting provider.
# VITE_* values are public and embedded into the frontend during build.

# Use the backend origin only; do not append /api.
# Example production value: https://your-backend.cleverapps.io
VITE_ADMIN_AUTH_MODE=server
VITE_PORTFOLIO_API_URL=http://localhost:3000

# Local Vite development port. It is not needed by most frontend hosting providers.
VITE_PORT=5174
