{
  "name": "portofolio-v2",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n FE,BE -c cyan,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:fe": "npm run dev --workspace frontend",
    "dev:be": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace frontend",
    "start": "npm run start --workspace backend",
    "backend": "npm run start --workspace backend",
    "server": "npm run start --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "pdf:generate": "npm run pdf:generate --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
